	G1 X{x_max} Y0 F{speed}
	G1 X0 Y0 F{speed}
	G1 X0 Y{y_max} F{speed}
	{% endfor %}
	M400
	
	
	G1 X{x_max} Y0 F{speed}
	
	
	{% for k in range(3) %}
	G1 X{x_max} Y{y_max} F{speed}
	G1 X0 Y{y_max} F{speed}
	G1 X0 Y0 F{speed}
	G1 X{x_max} Y0 F{speed}
	{% endfor %}
	M400
	
	
	
	
	M400
	M204 S3000
	G4 P200
	
	G1 X{x_mid} Y{y_mid} F6000
	M117 Test zakonczony

[gcode_macro SKRYPT_SRUBY]
gcode = 
	
	M117 Rozgrzewanie stolu...
	M190 S70
	
	
	M117 Bazowanie...
	G28
	
	
	M117 Pomiar srub...
	SCREWS_TILT_CALCULATE
	
	M117 Pomiar zakonczony!

[gcode_macro TEST_WYSOKOSCI]
gcode = 
	
	M117 Rozgrzewanie (Stol: 70, Dysza: 240)...
	M140 S70
	M104 S240
	
	
	M190 S70
	M109 S240
	
	
	M117 Bazowanie osi...
	G28
	
	
	G90
	
	
	M117 Zjazd na Z=0.2...
	G1 X110 Y110 Z0.2 F3000
	
	M117 Sprawdz kartke pod dysza!

[gcode_macro LUZUJ_XY]
gcode = 
	SET_STEPPER_ENABLE STEPPER=stepper_x ENABLE=0
	SET_STEPPER_ENABLE STEPPER=stepper_y ENABLE=0
	M117 Osie X i Y sa wolne!

[gcode_macro START_PRINT]
description = Start z adaptacyjną siatką (exclude_object) i linią czyszczącą
gcode = 
	{% set BED_TEMP = params.BED_TEMP|default(60)|float %}
	{% set EXTRUDER_TEMP = params.EXTRUDER_TEMP|default(200)|float %}
	
	G21
	G90
	M82
	M220 S100
	M221 S100
	
	M117 Grzanie w tle...
	M140 S{BED_TEMP}
	M104 S150
	
	M117 Bazowanie osi...
	G28
	
	M117 Czekam na stol...
	M190 S{BED_TEMP}
	
	M117 Probkowanie obszaru modelu...
	BED_MESH_CLEAR
	BED_MESH_CALIBRATE ADAPTIVE=1
	
	M117 Dogrzewanie dyszy...
	M109 S{EXTRUDER_TEMP}
	
	M117 Czyszczenie dyszy...
	G92 E0
	G1 Z2.0 F3000
	G1 X10.1 Y20 Z0.28 F5000.0
	G1 X10.1 Y200.0 Z0.28 F1500.0 E15
	G1 X10.4 Y200.0 Z0.28 F5000.0
	G1 X10.4 Y20 Z0.28 F1500.0 E30
	G92 E0
	G1 Z2.0 F3000
	
	M117 Drukuje...

[gcode_macro END_PRINT]
description = Bezpieczne zakończenie wydruku i prezentacja modelu
gcode = 
	G91
	G1 E-3 F2400
	G1 Z2.0 F2400
	G1 X5 Y5 F3000
	G90
	
	
	POZYCJA_DO_CZYSZCZENIA
	
	M106 S0
	M104 S0
	M140 S0
	M84 X Y E
	
	
	RESPOND MSG="Czekam na schłodzenie dyszy poniżej 50°C..."
	TEMPERATURE_WAIT SENSOR=extruder MAXIMUM=50
	
	M117 Wydruk zakonczony!
	RESPOND MSG="Dysza bezpieczna. Odcinam zasilanie płyty głównej!"
	
	
	G4 P1000
	SET_PIN PIN=zasilanie_skr VALUE=0

