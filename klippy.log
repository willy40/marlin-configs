serial = /dev/ttyAMA0
restart_method = command

[mcu host]
serial = /tmp/klipper_host_mcu

[printer]
kinematics = cartesian
max_velocity = 350
max_accel = 1900
max_z_velocity = 5
max_z_accel = 100
square_corner_velocity = 5.5

[firmware_retraction]
retract_length = 0.6
retract_speed = 35
unretract_extra_length = 0
unretract_speed = 20

[output_pin zasilanie_skr]
pin = host:gpio4
value = 1
shutdown_value = 1

[board_pins]
aliases = 
	
	EXP1_1=PB5,  EXP1_3=PA9,   EXP1_5=PA10, EXP1_7=PB8, EXP1_9=<GND>,
	EXP1_2=PA15, EXP1_4=<RST>, EXP1_6=PB9,  EXP1_8=PD6, EXP1_10=<5V>

[screws_tilt_adjust]
screw1 = 50, 35
screw1_name = lewy przod
screw2 = 220, 35
screw2_name = prawy przod
screw3 = 220, 210
screw3_name = prawy tyl
screw4 = 50, 210
screw4_name = lewy tyl
horizontal_move_z = 10
speed = 150
screw_thread = CW-M4

[exclude_object]

[bed_mesh default]
version = 1
points = 
	0.039038, 0.027788, 0.001538, 0.011538, 0.024038, 0.035288
	0.005288, -0.022212, -0.044712, -0.034712, 0.009038, 0.031538
